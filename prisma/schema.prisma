// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REPORTER
  MANAGER
  DIRECTOR
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  role      UserRole  @default(REPORTER)
  name      String
  position  String
  email     String    @unique
  password  String
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  problems Problem[]

  @@map("users")
}

enum Status {
  TO_ANALYSIS
  IN_ANALYSIS
  ACCEPTED
  REJECTED
  IN_PROGRESS
  FINISHED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

model Problem {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  description     String
  status          Status           @default(TO_ANALYSIS)
  maintenanceType MaintenanceType? @map("maintenance_type")
  reporterId      String           @map("reporter_id")
  locationId      String           @map("location_id")
  categoryId      String?          @map("category_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  purgedAt        DateTime?        @map("purged_at")

  reporter    User                @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  history     ProblemHistory[]
  googleSheetImports GoogleSheetImport[]

  @@map("problems")
}

enum HistoryAction {
  STATUS_CHANGED
  CATEGORY_CHANGED
  MAINTENANCE_TYPE_CHANGED
  NOTE_ADDED
  UPDATED
}

model ProblemHistory {
  id        String        @id @default(uuid())
  problemId String        @map("problem_id")
  action    HistoryAction
  userId    String        @map("user_id")
  userName  String        @map("user_name")
  note      String?
  changes   Json?
  createdAt DateTime      @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("problem_history")
}

model Attachment {
  id        String  @id @default(uuid())
  title     String
  url       String
  problemId String? @map("problem_id")

  problem Problem? @relation(fields: [problemId], references: [id])

  @@map("attachments")
}

model Location {
  id          String    @id @default(uuid())
  name        String
  description String?
  code        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  purgedAt    DateTime? @map("purged_at")

  problems Problem[]

  @@map("locations")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  purgedAt    DateTime? @map("purged_at")

  problems Problem[]

  @@map("categories")
}

model GoogleSheetImport {
  id            String   @id @default(uuid())
  spreadsheetId String   @map("spreadsheet_id")
  sheetName     String   @map("sheet_name")
  rowIndex      Int      @map("row_index")
  problemId     String   @map("problem_id")
  createdAt     DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, sheetName, rowIndex])
  @@map("google_sheet_imports")
}
