{
  "name": "campus-ativo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "dev": "npm run start:dev",
    "start": "node dist/src/infra/main.js",
    "start:dev": "nest start --debug --watch",
    "start:prod": "node dist/src/infra/main.js",
    "start:render": "npm run prisma:migrate:deploy && npm run start:prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "openapi": "./scripts/generate-openapi.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.6",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@rocketseat/eslint-config": "3.0.12",
    "@swc/core": "1.15.21",
    "@types/express": "4.17.17",
    "@types/multer": "2.1.0",
    "@types/node": "25.5.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.2",
    "dotenv": "17.3.1",
    "dotenv-expand": "12.0.3",
    "eslint": "10.1.0",
    "prettier": "3.8.1",
    "prisma": "7.6.0",
    "supertest": "7.2.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.2"
  },
  "overrides": {
    "@angular-devkit/core": {
      ".": "19.2.23",
      "ajv": "8.18.0",
      "picomatch": "4.0.4"
    },
    "@angular-devkit/schematics": "19.2.23",
    "@angular-devkit/schematics-cli": "19.2.23",
    "path-to-regexp": "8.4.0",
    "picomatch": "4.0.4"
  }
}
