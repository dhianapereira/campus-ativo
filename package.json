{
  "name": "ifal-arapiraca-backend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/infra/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "generate:openapi": "./scripts/generate-openapi.sh",
    "openapi": "./scripts/generate-openapi.sh",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.16",
    "@nestjs/swagger": "11.2.6",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "googleapis": "144.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.0",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.3",
    "zod-validation-error": "3.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "9.8.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.6",
    "@rocketseat/eslint-config": "3.0.12",
    "@swc/core": "1.12.1",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.17",
    "@types/multer": "2.0.0",
    "@types/node": "22.12.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.3",
    "dotenv": "16.5.0",
    "eslint": "8.57.0",
    "prettier": "^3.8.1",
    "prisma": "7.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.1",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.11",
    "@mrleebo/prisma-ast": "0.14.0",
    "ajv": "8.18.0",
    "eslint": {
      "ajv": "6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "6.12.6"
    },
    "hono": "4.12.5",
    "lodash": "4.17.23"
  }
}
