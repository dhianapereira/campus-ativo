# Database
POSTGRES_CONTAINER_NAME=campus-ativo-pg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=campus-ativo
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

# Server
PORT=3333
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=campus-ativo
AWS_S3_SIGNED_URL_TTL=900

# System user
SYSTEM_USER_EMAIL=autobot@campusativo
SYSTEM_USER_NAME=Autobot
SYSTEM_USER_POSITION=Bot
