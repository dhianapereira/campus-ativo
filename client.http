@baseUrl = http://localhost:3333
@authToken = {{authenticate.response.body.access_token}}

# @name create_account
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "Maria dos Santos",
  "position": "Diretora",
  "email": "maria@email.com",
  "password": "123456"
}

###
# @name authenticate
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "123456"
}

###
# @name create_location
POST {{baseUrl}}/locations
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Sala de aula",
  "code": "001",
  "description": "No primeiro andar do lado esquerdo"
}

###
# @name fetch_locations
GET {{baseUrl}}/locations?page=1
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
# @name create_category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Infraestrutura",
  "description": "Ex.: Rachaduras no teto"
}

###
# @name fetch_categories
GET {{baseUrl}}/categories?page=1
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
# @name create_problem
POST {{baseUrl}}/problems
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Ar-condicionado da Sala 01 com defeito",
  "description": "O ar-condicionado da sala 01 não está ligando.",
  "locationId": "708ec7c8-283d-4ece-a61d-accbf8bcfdda",
  "categoryId": "7b247bcf-0071-4468-82d1-e1f1c3960c59"
}

###
# @name fetch_problems
GET {{baseUrl}}/problems?page=1
Content-Type: application/json
Authorization: Bearer {{authToken}}